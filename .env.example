# Google Analytics 4 measurement ID (e.g. G-XXXXXXXXXX).
# Leave unset to disable analytics entirely — the cookie consent banner
# and gtag loader both no-op without it.
VITE_GA_MEASUREMENT_ID=

# Vercel AI Gateway (server-side only; never prefix with VITE_)
AI_GATEWAY_API_KEY=
AXIROVA_AI_MODEL=

# Optional lead destination webhook (server-side only)
GOOGLE_APPS_SCRIPT_URL=
GOOGLE_APPS_SCRIPT_TOKEN=
