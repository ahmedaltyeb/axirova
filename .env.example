# Public, build-time configuration
VITE_SITE_URL=https://axirova.ae
# Optional confirmed Calendly / Cal.com embed URL
VITE_BOOKING_URL=
# Set only for GitHub Pages builds (the workflow sets this automatically)
VITE_GH_PAGES=false
# Server-only AI configuration. Without a key the assistant is explicitly in guided mode.
OPENAI_API_KEY=
OPENAI_ASSISTANT_MODEL=gpt-4.1-mini
# Google Sheets + email together through the supplied Apps Script web app.
# Set both server-only variables after publishing the script. Never expose the token in VITE_ variables.
GOOGLE_APPS_SCRIPT_URL=
GOOGLE_APPS_SCRIPT_TOKEN=
# Server-only: configure webhook OR all three Resend values. Never prefix secrets with VITE_.
ENQUIRY_WEBHOOK_URL=
ENQUIRY_WEBHOOK_TOKEN=
RESEND_API_KEY=
ENQUIRY_FROM_EMAIL=
ENQUIRY_TO_EMAIL=info@axirova.ae
